{
  "name": "bluesoft-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "BLUESOFT 디자인시스템 SCSS 마스터",
  "scripts": {
    "build": "sass scss/main.scss:dist/main.css --no-source-map",
    "postbuild": "node scripts/sync-docs-assets.mjs && node scripts/generate-docs-tokens.mjs",
    "check:nodes": "node scripts/check-nodes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint": "stylelint \"scss/**/*.scss\"",
    "check": "npm run check:nodes && npm run check:tokens && npm run lint"
  },
  "devDependencies": {
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
